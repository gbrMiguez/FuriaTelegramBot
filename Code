logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)
logger = logging.getLogger(__name__)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text('Olá Furioso, o que gostaria de saber sobre a FURIA hoje? Use /perguntas para ver todos os comandos disponíveis.')

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text('Use /perguntas para ver todos os comandos disponíveis.')

async def perguntas(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    comandos = "\n".join(sorted(custom_qas.keys()))
    await update.message.reply_text(f"Comandos disponíveis:\n{comandos}")

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    message_text = update.message.text.lower()
    
    # Check if it's a command (starts with /)
    if message_text.startswith('/'):
        resposta = custom_qas.get(message_text, "Desculpe, não reconheço esse comando. Use /perguntas para ver todos os comandos disponíveis.")
        await update.message.reply_text(resposta)
    else:
        # Handle non-command messages
        await update.message.reply_text("Por favor, use um dos comandos disponíveis. Digite /perguntas para ver a lista de comandos.")

def main():
    # Initialize the Application
    app = Application.builder().token(TELEGRAM_TOKEN).build()
    
    # Add handlers for basic commands
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("perguntas", perguntas))
    
    # Add handler for all messages (including commands in custom_qas)
    app.add_handler(MessageHandler(filters.TEXT, handle_message))
    
    # Start the bot
    print("Starting bot...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == '__main__':
    main()
